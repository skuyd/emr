# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me-before-deployment
ACCOUNTS_CRYPTO_SECRET=change-me-before-deployment
NOTIFICATIONS_CRYPTO_SECRET=change-me-before-deployment
TOMBSTONE_HASH_KEY=change-me-before-deployment
TOMBSTONE_SIGNING_KEY=change-me-before-deployment
ANALYTICS_HASH_KEY=change-me-before-deployment
AUDIT_HASH_KEY=change-me-before-deployment
OPERATIONS_METRICS_TOKEN=change-me-before-deployment-at-least-32-characters
OPERATIONS_ALERT_QUEUE_THRESHOLD=100
OPERATIONS_ALERT_DELETION_THRESHOLD=20
OPERATIONS_ALERT_PROVIDER_ERROR_THRESHOLD=10
WEBPUSH_ENABLED=False
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=mailto:operations@example.invalid
WEBPUSH_TTL_SECONDS=300
WEBPUSH_TIMEOUT_SECONDS=10
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Local development services
DATABASE_URL=sqlite:///db.sqlite3
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
OTP_PROVIDER=console

# Object storage examples
AWS_ACCESS_KEY_ID=example-access-key
AWS_SECRET_ACCESS_KEY=example-secret-key
AWS_STORAGE_BUCKET_NAME=family-phr-example
AWS_S3_REGION_NAME=ap-northeast-1
AWS_S3_ENDPOINT_URL=http://127.0.0.1:9000
AWS_S3_ADDRESSING_STYLE=path

# Docker Compose local-development services. Run `python deploy/bootstrap_dev_env.py`
# once to create a private .env with fresh secrets; it never overwrites an existing file.
POSTGRES_DB=familyphr_dev
POSTGRES_USER=familyphr_dev
POSTGRES_PASSWORD=change-me-before-deployment
POSTGRES_PORT=5432
REDIS_PORT=6379
REDIS_PASSWORD=change-me-before-deployment
MINIO_ROOT_USER=familyphr_local_admin
MINIO_ROOT_PASSWORD=change-me-before-deployment
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=familyphr-local
