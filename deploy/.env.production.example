APP_DOMAIN=required-app-domain.example
APP_IMAGE_TAG=local
ACME_EMAIL=required-operations-contact@example.invalid
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOW_PERFORMANCE_SEED=False
RESTORE_DRILL_MODE=False
DJANGO_SECRET_KEY=change-me-before-deployment
DJANGO_ALLOWED_HOSTS=required-app-domain.example
CSRF_TRUSTED_ORIGINS=https://required-app-domain.example
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
DJANGO_TRUST_X_FORWARDED_PROTO=True
PHR_PROXY_SUBNET=172.30.50.0/28
PHR_PROXY_ADDRESS=172.30.50.2

ACCOUNTS_CRYPTO_SECRET=change-me-before-deployment
NOTIFICATIONS_CRYPTO_SECRET=change-me-before-deployment
TOMBSTONE_HASH_KEY=change-me-before-deployment
TOMBSTONE_SIGNING_KEY=change-me-before-deployment
ANALYTICS_HASH_KEY=change-me-before-deployment
AUDIT_HASH_KEY=change-me-before-deployment
OPERATIONS_METRICS_TOKEN=change-me-before-deployment-at-least-32-characters
OPERATIONS_READINESS_TIMEOUT_SECONDS=1
OPERATIONS_READINESS_CACHE_SECONDS=2

POSTGRES_DB=familyphr
POSTGRES_USER=familyphr
POSTGRES_PASSWORD=change-me-before-deployment
DATABASE_URL=postgresql://familyphr:change-me-before-deployment@postgres:5432/familyphr
DATABASE_SSL_REQUIRE=False
DATABASE_CONN_MAX_AGE=60

REDIS_PASSWORD=change-me-before-deployment
REDIS_URL=redis://:change-me-before-deployment@redis:6379/0
CELERY_BROKER_URL=redis://:change-me-before-deployment@redis:6379/0
CELERY_RESULT_BACKEND=redis://:change-me-before-deployment@redis:6379/1

MINIO_ROOT_USER=change-me-before-deployment
MINIO_ROOT_PASSWORD=change-me-before-deployment
DOCUMENT_STORAGE_BACKEND=s3
DOCUMENT_S3_BUCKET=family-phr-private
DOCUMENT_S3_ENDPOINT_URL=http://minio:9000
DOCUMENT_S3_REGION=us-east-1
DOCUMENT_S3_ACCESS_KEY_ID=change-me-before-deployment
DOCUMENT_S3_SECRET_ACCESS_KEY=change-me-before-deployment
DOCUMENT_S3_PREFIX=closed-trial
DOCUMENT_S3_ALLOWED_HOSTS=minio
DOCUMENT_S3_ALLOW_INSECURE_INTERNAL=True
DOCUMENT_S3_REQUIRE_ENCRYPTION=False

OTP_PROVIDER=https_gateway
SMS_GATEWAY_URL=https://required-sms-gateway.example/send
SMS_GATEWAY_API_KEY=required-sms-api-key
SMS_GATEWAY_SIGNING_SECRET=change-me-before-deployment
SMS_GATEWAY_TEMPLATE_ID=required-login-template
SMS_GATEWAY_ALLOWED_HOSTS=required-sms-gateway.example
SMS_GATEWAY_TIMEOUT_SECONDS=10

WEBPUSH_ENABLED=False
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_VAPID_SUBJECT=https://required-app-domain.example
WEBPUSH_TTL_SECONDS=300
WEBPUSH_TIMEOUT_SECONDS=10
WEBPUSH_ALLOWED_ENDPOINT_HOSTS=fcm.googleapis.com,updates.push.services.mozilla.com,web.push.apple.com,.notify.windows.com

PHR_OCR_PROVIDER=paddle
PHR_OCR_DEVICE=cpu
PHR_OCR_PADDLE_DETECTION_MODEL=PP-OCRv5_mobile_det
PHR_OCR_PADDLE_RECOGNITION_MODEL=PP-OCRv5_mobile_rec
PHR_OCR_PADDLE_DETECTION_MODEL_DIR=/models/detection
PHR_OCR_PADDLE_RECOGNITION_MODEL_DIR=/models/recognition
PROCESSING_DISPATCH_ON_UPLOAD=True
GUNICORN_WORKERS=3
GUNICORN_THREADS=4
CELERY_WORKER_CONCURRENCY=1
CELERY_CONTROL_WORKER_CONCURRENCY=2
OCR_MODEL_ROOT=required-absolute-host-model-path
