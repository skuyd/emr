# This source document is byte-hashed by the release traceability gate.
/docs/archive/product/prd-v1.md text eol=lf

# Attestations hash these artifacts as bytes on every platform.
/docs/verification/artifacts/*.json text eol=lf
# Keep both recorded evaluations' original bytes, including line endings.
/docs/verification/artifacts/batch-four-treatment-cycles-first-evaluation.json -text whitespace=cr-at-eol
/docs/verification/artifacts/batch-four-treatment-cycles-second-evaluation.json -text whitespace=cr-at-eol

# Release corpus and dictionary identities must match across checkout platforms.
/apps/labs/dictionaries/phase-two*.json text eol=lf

# Preserve the upstream font license bytes, including its original whitespace.
/docs/licenses/noto-sans-sc-ofl.txt -text -whitespace

# Cloud bootstrap scripts must remain executable by Linux shells after checkout.
/deploy/tencent/*.sh text eol=lf
